QMainWindow {
    background-color: #ffffff;
    border: none;
    font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
}

QWidget#centralwidget {
    background-color: #ffffff;
    padding: 0px;
    margin: 0px;
}

QWidget#widget {
    background-color: #f5f5f5;
    border-radius: 0px;
    margin: 0px;
    padding: 8px 0px;
    border-right: 1px solid #e0e0e0;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 12px 8px;
    font-size: 11px;
    color: #666666;
    white-space: nowrap;
    margin: 2px 0px;
    border-radius: 0px;
    text-align: center;
    min-width: 48px;
    margin-left: 0px;
}

QToolButton:hover {
    background-color: #e8e8e8;
}

QToolButton::pressed, QToolButton::checked {
    background-color: #ffffff;
    border-left: 3px inset #2ecc71;
    color: #1890ff;
}

QStackedWidget {
    background-color: #ffffff;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}

QWidget#pageStudent,
QWidget#pageShedule,
QWidget#pageFinance,
QWidget#pageHonor,
QWidget#pageSystemSetting {
    background-color: #ffffff;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    gridline-color: #f0f0f0;
    selection-background-color: #e6f7ff;
    selection-color: #1890ff;
    alternate-background-color: #fafafa;
    border-right: none;
}

QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
}

QHeaderView::section {
    background-color: #fafafa;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    border-right: 1px solid #e0e0e0;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
    color: #333333;
    min-width: 70px;
    white-space: nowrap;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #f0f0f0;
}

QScrollBar:vertical {
    border: none;
    background: #f5f5f5;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d9d9d9;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #bfbfbf;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #f5f5f5;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #d9d9d9;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #bfbfbf;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QPushButton {
    background-color: #1890ff;
    border: none;
    color: white;
    padding: 8px 20px;
    border-radius: 4px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #096dd9;
}

QPushButton:pressed {
    background-color: #0050b3;
}

QStatusBar {
    background-color: #fafafa;
    color: #666666;
    border-top: 1px solid #e0e0e0;
}
